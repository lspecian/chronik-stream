# syntax=docker/dockerfile:1
#
# chronik-operator built from source (local development).
# Releases use Dockerfile.operator.binary, which packages a binary built by CI;
# the runtime stage below matches it.
#
#   docker build -f Dockerfile.operator -t chronik-operator:dev .
#
# The whole workspace is copied rather than a list of crates: Cargo needs every
# member's manifest to resolve the workspace, and a hand-kept list went stale
# whenever a crate was added or removed. Rebuilds stay fast through BuildKit
# cache mounts for the registry and target directory.

# Stage 1: build. Rust stable, as CI uses. The operator depends only on
# chronik-scram and pure-Rust crates, so no system libraries are needed.
FROM rust:1-bookworm AS builder

WORKDIR /build
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo build --release --locked -p chronik-operator --bin chronik-operator && \
    cp target/release/chronik-operator /chronik-operator

# Stage 2: runtime, the same as Dockerfile.operator.binary. Built on Debian
# bookworm (glibc 2.36), the binary runs on Ubuntu 24.04 (glibc 2.39).
FROM ubuntu:24.04

RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1002 -g operator operator

COPY --from=builder /chronik-operator /usr/local/bin/chronik-operator
RUN chmod +x /usr/local/bin/chronik-operator

USER operator

EXPOSE 8080

# The base image has neither wget nor curl; bash's /dev/tcp needs no package.
# /healthz always answers 200, so an accepted connection is the same signal.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["bash", "-c", "</dev/tcp/127.0.0.1/8080"]

ENTRYPOINT ["chronik-operator"]
CMD ["start"]
