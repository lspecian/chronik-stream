# Optimized Dockerfile using pre-built operator binary
# This avoids compilation entirely - just copies the right binary

FROM ubuntu:24.04

# Automatically selects the right architecture
ARG TARGETARCH

# The release tag. Declared before the apt layer so that layer is rebuilt for
# every release instead of being reused from the build cache, which would keep
# shipping whatever package versions were current when it was first cached.
ARG VERSION

# Install minimal runtime dependencies, plus the security updates published
# since the base image was built (ubuntu:24.04 is refreshed only every few weeks)
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1002 -g operator operator

# Copy the pre-built binary for the target architecture
# Expects binaries in artifacts/linux/{amd64,arm64}/chronik-operator
COPY artifacts/linux/${TARGETARCH}/chronik-operator /usr/local/bin/chronik-operator

# Ensure binary is executable
RUN chmod +x /usr/local/bin/chronik-operator

# Switch to non-root user
USER operator

# Expose metrics/health port
EXPOSE 8080

# Health check
# The base image has neither wget nor curl; bash's /dev/tcp needs no package.
# /healthz always answers 200, so an accepted connection is the same signal.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["bash", "-c", "</dev/tcp/127.0.0.1/8080"]

# Run the operator
ENTRYPOINT ["chronik-operator"]
CMD ["start"]
